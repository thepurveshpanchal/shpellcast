# shpellcast configuration — /etc/shpellcast/shpellcast.env
#
# Every setting here has a command-line twin (SHPELLCAST_FOO_BAR == -foo-bar).
# Edit, then: sudo systemctl restart shpellcast

# --- listeners ------------------------------------------------------------
# Web UI and API. Bind to 127.0.0.1 when a reverse proxy terminates TLS.
SHPELLCAST_HTTP=:8080

# Raw TCP ingest, the `nc host 1337` endpoint. Set to empty to disable it
# and accept output over HTTP only.
SHPELLCAST_TCP=:1337

# --- public identity ------------------------------------------------------
# The origin printed in session links. Set this. Without it, links are built
# from the request Host header, and the netcat banner falls back to the
# listen address, which is almost never what a user should see.
#SHPELLCAST_BASE_URL=https://cast.example.com

# Honour X-Forwarded-For / X-Forwarded-Proto. Turn this on ONLY when the
# service is reachable exclusively through your own reverse proxy: these
# headers are trivially forged and they gate the per-client limits.
#SHPELLCAST_TRUST_PROXY=true

# --- retention ------------------------------------------------------------
# Output kept per session, in memory. This is the hard memory cost per live
# session; 1000 concurrent sessions at 256KB is ~256MB.
SHPELLCAST_BUFFER=256KB

# Total output accepted per session before the producer is cut off.
SHPELLCAST_QUOTA=64MB

# Expiry. Sessions vanish on their own; nothing here is forever.
SHPELLCAST_IDLE_TTL=24h
SHPELLCAST_CLOSED_TTL=6h
SHPELLCAST_MAX_TTL=168h

# Mirror sessions to disk so output survives a restart. Must be writable by
# the service; with the shipped unit that means StateDirectory.
#SHPELLCAST_SPILL_DIR=/var/lib/shpellcast

# --- limits ---------------------------------------------------------------
# Server-wide ceiling. Measured: 1000 concurrent sessions each with a live
# viewer cost ~100MB and ~0.5ms p99 end-to-end latency on 2 vCPUs. Keep
# this consistent with MemoryMax in the unit file (see the note there).
SHPELLCAST_MAX_SESSIONS=2000

# Sessions allowed from one source address. This stops a single host
# exhausting the server; it is NOT meant to ration normal use.
#
# Read this before lowering it: producers behind NAT, a CI runner fleet,
# or a reverse proxy without SHPELLCAST_TRUST_PROXY all arrive as ONE
# address, so this value caps your whole fleet, not one laptop. If you
# expect 100 concurrent builds from one CI host, this must exceed 100.
# Set to 0 to disable. Watch shpellcast_sessions_rejected_perclient_total.
SHPELLCAST_MAX_PER_CLIENT=250

SHPELLCAST_TCP_IDLE=30m

# --- misc -----------------------------------------------------------------
# Session URLs are unguessable capabilities; 16 chars is 80 bits.
SHPELLCAST_ID_LENGTH=16

# Publish the list of live sessions at /sessions and on the home page.
# This hands every visitor every session URL. Leave it off unless the
# service is on a private network and you want the convenience.
SHPELLCAST_INDEX=false

SHPELLCAST_LOG_LEVEL=info
