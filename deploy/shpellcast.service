[Unit]
Description=shpellcast — pipe command output to a web page
Documentation=https://github.com/purvesh/shpellcast
After=network-online.target
Wants=network-online.target

[Service]
# Type=exec (systemd >= 240) reports start failures such as "port already
# in use" instead of reporting success and dying a moment later.
Type=exec
ExecStart=/usr/local/bin/shpellcast
EnvironmentFile=-/etc/shpellcast/shpellcast.env

# --- identity -------------------------------------------------------------
# DynamicUser gives the service a transient, unprivileged UID that exists
# only while it runs: nothing to create, nothing left behind, and no
# long-lived account for an attacker to reuse.
DynamicUser=yes
# StateDirectory is where -spill-dir should point if you enable it.
StateDirectory=shpellcast
StateDirectoryMode=0750

# --- privileges -----------------------------------------------------------
# Binding :80/:443 or any port under 1024 would need this; the defaults
# (8080/1337) do not, so no capabilities are granted at all.
CapabilityBoundingSet=
AmbientCapabilities=
NoNewPrivileges=yes

# --- filesystem -----------------------------------------------------------
ProtectSystem=strict
ProtectHome=yes
PrivateTmp=yes
PrivateDevices=yes
ProtectKernelTunables=yes
ProtectKernelModules=yes
ProtectKernelLogs=yes
ProtectControlGroups=yes
ProtectClock=yes
ProtectHostname=yes
ProtectProc=invisible
ProcSubset=pid
ReadWritePaths=/var/lib/shpellcast

# --- kernel / syscalls ----------------------------------------------------
RestrictNamespaces=yes
RestrictRealtime=yes
RestrictSUIDSGID=yes
RestrictAddressFamilies=AF_INET AF_INET6
LockPersonality=yes
MemoryDenyWriteExecute=yes
SystemCallArchitectures=native
SystemCallFilter=@system-service
SystemCallErrorNumber=EPERM
UMask=0077

# --- resources ------------------------------------------------------------
# A streaming server is file-descriptor bound, not CPU bound: one producer
# plus its viewers each hold a socket open for the life of the job. Budget
# roughly 2 descriptors per concurrent session (producer + one viewer) and
# one more per extra viewer. 65535 covers the default 2000-session cap
# with room to spare; measured at 1000 sessions + 1000 viewers: 2009 fds.
LimitNOFILE=65535

# Goroutines are not tasks. At 1000 concurrent sessions the process used
# ~4000 goroutines but only 9 OS threads, so this is generous already.
TasksMax=4096

# Worst case is SHPELLCAST_MAX_SESSIONS x SHPELLCAST_BUFFER plus about 30%
# for sockets and runtime overhead. At the shipped defaults (2000 x 256KB)
# that ceiling is ~650MB, hence 1G here.
#
# Buffers grow on demand, so the typical figure is far lower: 1000 live
# sessions each streaming steadily measured ~100MB resident. If you raise
# the session cap or the buffer size, raise this to match, or the kernel
# will OOM-kill the service at exactly the moment it is busiest.
MemoryMax=1G

# --- lifecycle ------------------------------------------------------------
Restart=on-failure
RestartSec=2s
# The process drains live connections on SIGTERM; give it room to finish.
TimeoutStopSec=20s
KillSignal=SIGTERM

[Install]
WantedBy=multi-user.target
